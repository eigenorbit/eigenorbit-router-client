      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Instance Name"
    },
    "plan": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Plan"
    },
    "region": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Region"
    },
    "status": {
      "enum": [
        "active",
        "invalid"
      ],
      "title": "Status",
      "type": "string"
    },
    "token_last4": {
      "title": "Token Last4",
      "type": "string"
    },
    "validated_at": {
      "format": "date-time",
