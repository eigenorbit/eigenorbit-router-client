{
  "$defs": {
    "ArrayResult": {
      "description": "A numpy float64 array: `data` nests `len(shape)` levels deep (a bare float for []).",
      "properties": {
        "data": {
          "$ref": "#/$defs/NestedFloats"
        },
        "dtype": {
          "const": "float64",
          "title": "Dtype",
          "type": "string"
        },
        "kind": {
          "const": "array",
          "title": "Kind",
          "type": "string"
        },
        "shape": {
          "items": {
            "minimum": 0,
            "type": "integer"
          },
          "title": "Shape",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "dtype",
        "shape",
        "data"
      ],
      "title": "ArrayResult",
      "type": "object"
    },
    "CountsResult": {
      "description": "Measurement counts keyed by bitstring (qubit 0 is the leftmost character).",
      "properties": {
        "data": {
          "additionalProperties": {
            "minimum": 0,
            "type": "integer"
          },
          "title": "Data",
          "type": "object"
        },
        "kind": {
          "const": "counts",
          "title": "Kind",
          "type": "string"
        },
        "n_qubits": {
          "minimum": 1,
          "title": "N Qubits",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "n_qubits",
        "data"
      ],
      "title": "CountsResult",
      "type": "object"
    },
    "ExecutionOut": {
      "description": "What the router ran on the vendor for one job: one transpiled or compiled program.\n\ninitial_layout[i] is the physical qubit logical qubit i starts on.\nfinal_layout[i] is the physical qubit holding logical qubit i at the end, where\nits measurement and observables are read.\nactive_qubits are the sorted physical qubits any non-barrier operation touched.\nibm_options are the dynamical decoupling and twirling options IBM stored with the\njob, null when it stored none.\nFor Braket, vendor_job_id is the task id (the task ARN without its prefix).\ntranspiled_qasm3 is the OpenQASM 3 program an IQM or AQT device compiled, and\ncompiled_quil the Quil program a Rigetti device compiled, both as Braket returned\nthem. final_layout is read from that compiled program's measure statements:\nfinal_layout[i] is the physical qubit classical bit i was measured on, null when\nthey do not measure each of the job's bits exactly once into one register.\nactive_qubits are the physical qubits of transpiled_qasm3, or those the gate and\nmeasure instructions of compiled_quil act on. Braket's Quil may leave gate angles\nas compiler parameters (_braket_compiler_ssa_N_) whose values Braket does not\nreturn, so compiled_quil is not a complete record of what ran. initial_layout and\nthe transpiler, library and option fields are for IBM only.\nEvery field except vendor_job_id may be null when the router could not read it.",
      "properties": {
        "active_qubits": {
          "anyOf": [
            {
              "items": {
                "minimum": 0,
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Active Qubits"
        },
        "compiled_quil": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Compiled Quil"
        },
        "final_layout": {
          "anyOf": [
            {
              "items": {
                "minimum": 0,
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Final Layout"
        },
        "ibm_options": {
          "anyOf": [
            {
              "$ref": "#/$defs/IbmOptionsOut"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "initial_layout": {
          "anyOf": [
            {
              "items": {
                "minimum": 0,
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Initial Layout"
        },
        "optimization_level": {
          "anyOf": [
            {
              "maximum": 3,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Optimization Level"
        },
        "qiskit_ibm_runtime_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Qiskit Ibm Runtime Version"
        },
        "qiskit_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Qiskit Version"
        },
        "seed_transpiler": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed Transpiler"
        },
        "transpiled_qasm3": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transpiled Qasm3"
        },
        "vendor_job_id": {
          "minLength": 1,
          "title": "Vendor Job Id",
          "type": "string"
        }
      },
      "required": [
        "vendor_job_id"
      ],
      "title": "ExecutionOut",
      "type": "object"
    },
    "IbmDynamicalDecouplingOut": {
      "description": "Dynamical decoupling options IBM stored with the job.",
      "properties": {
        "enable": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Enable"
        },
        "sequence_type": {
          "anyOf": [
            {
              "enum": [
                "XX",
                "XpXm",
                "XY4"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sequence Type"
        }
      },
      "title": "IbmDynamicalDecouplingOut",
      "type": "object"
    },
    "IbmOptionsOut": {
      "description": "The dynamical decoupling and twirling options IBM stored with the job.\n\nOnly the keys IBM stored are present. Options IBM applies by default on the\nserver are not stored, and so not shown.",
      "properties": {
        "dynamical_decoupling": {
          "anyOf": [
            {
              "$ref": "#/$defs/IbmDynamicalDecouplingOut"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "twirling": {
          "anyOf": [
            {
              "$ref": "#/$defs/IbmTwirlingOut"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "IbmOptionsOut",
      "type": "object"
    },
    "IbmTwirlingOut": {
      "description": "Pauli twirling options IBM stored with the job.",
      "properties": {
        "enable_gates": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Enable Gates"
        },
        "enable_measure": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Enable Measure"
        },
        "num_randomizations": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Num Randomizations"
        },
        "shots_per_randomization": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Shots Per Randomization"
        }
      },
      "title": "IbmTwirlingOut",
      "type": "object"
    },
    "Method": {
      "description": "Mirrors kit CompiledCircuit methods.",
      "enum": [
        "run",
        "sample",
        "probabilities",
        "zero_state_probability"
      ],
      "title": "Method",
      "type": "string"
    },
    "NestedFloats": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "items": {
            "$ref": "#/$defs/NestedFloats"
          },
          "type": "array"
        }
      ]
    }
  },
  "description": "GET /v1/jobs/{job_id}/result. Returned as soon as status is completed.\n\nShapes by method: run -> [n_observables]; zero_state_probability -> [];\nprobabilities -> [2**n_qubits]; sample -> counts.\n`execution` is what the router ran on the vendor, for IBM Quantum and Braket jobs;\nnull for results stored before the router recorded it.",
  "properties": {
    "bit_order": {
      "const": "qubit0_msb",
      "title": "Bit Order",
      "type": "string"
    },
    "execution": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExecutionOut"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "job_id": {
      "format": "uuid",
      "title": "Job Id",
      "type": "string"
    },
    "method": {
      "$ref": "#/$defs/Method"
    },
    "result": {
      "discriminator": {
        "mapping": {
          "array": "#/$defs/ArrayResult",
          "counts": "#/$defs/CountsResult"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ArrayResult"
        },
        {
          "$ref": "#/$defs/CountsResult"
        }
      ],
      "title": "Result"
    }
  },
  "required": [
    "job_id",
    "method",
    "bit_order",
    "result"
  ],
  "title": "JobResultOut",
  "type": "object"
}
