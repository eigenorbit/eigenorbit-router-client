{
  "$defs": {
    "ArrayResult": {
      "description": "A numpy float64 array: `data` nests `len(shape)` levels deep (a bare float for []).",
      "properties": {
        "data": {
          "$ref": "#/$defs/NestedFloats"
        },
        "dtype": {
          "const": "float64",
          "title": "Dtype",
          "type": "string"
        },
        "kind": {
          "const": "array",
          "title": "Kind",
          "type": "string"
        },
        "shape": {
          "items": {
            "minimum": 0,
            "type": "integer"
          },
          "title": "Shape",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "dtype",
        "shape",
        "data"
      ],
      "title": "ArrayResult",
      "type": "object"
    },
    "CountsResult": {
      "description": "Measurement counts keyed by bitstring (qubit 0 is the leftmost character).",
      "properties": {
        "data": {
          "additionalProperties": {
            "minimum": 0,
            "type": "integer"
          },
          "title": "Data",
          "type": "object"
        },
        "kind": {
          "const": "counts",
          "title": "Kind",
          "type": "string"
        },
        "n_qubits": {
          "minimum": 1,
          "title": "N Qubits",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "n_qubits",
        "data"
      ],
      "title": "CountsResult",
      "type": "object"
    },
    "ExecutionOut": {
      "description": "What the router ran on the vendor for one job: one transpiled circuit.\n\ninitial_layout[i] is the physical qubit logical qubit i starts on.\nfinal_layout[i] is the physical qubit holding logical qubit i at the end, where\nits measurement and observables are read.\nactive_qubits are the sorted physical qubits any non-barrier operation touched.\nEvery field except vendor_job_id may be null when the router could not read it.",
      "properties": {
        "active_qubits": {
          "anyOf": [
            {
              "items": {
                "minimum": 0,
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Active Qubits"
        },
        "final_layout": {
          "anyOf": [
            {
              "items": {
                "minimum": 0,
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Final Layout"
        },
        "initial_layout": {
          "anyOf": [
            {
              "items": {
                "minimum": 0,
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Initial Layout"
        },
        "optimization_level": {
          "anyOf": [
            {
              "maximum": 3,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Optimization Level"
        },
        "qiskit_ibm_runtime_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Qiskit Ibm Runtime Version"
        },
        "qiskit_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Qiskit Version"
        },
        "seed_transpiler": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed Transpiler"
        },
        "transpiled_qasm3": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transpiled Qasm3"
        },
        "vendor_job_id": {
          "minLength": 1,
          "title": "Vendor Job Id",
          "type": "string"
        }
      },
      "required": [
        "vendor_job_id"
      ],
      "title": "ExecutionOut",
      "type": "object"
    },
    "Method": {
      "description": "Mirrors kit CompiledCircuit methods.",
      "enum": [
        "run",
        "sample",
        "probabilities",
        "zero_state_probability"
      ],
      "title": "Method",
      "type": "string"
    },
    "NestedFloats": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "items": {
            "$ref": "#/$defs/NestedFloats"
          },
          "type": "array"
        }
      ]
    }
  },
  "description": "GET /v1/jobs/{job_id}/result. Returned as soon as status is completed.\n\nShapes by method: run -> [n_observables]; zero_state_probability -> [];\nprobabilities -> [2**n_qubits]; sample -> counts.\n`execution` is what the router ran on the vendor, for IBM Quantum jobs; null otherwise.",
  "properties": {
    "bit_order": {
      "const": "qubit0_msb",
      "title": "Bit Order",
      "type": "string"
    },
    "execution": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExecutionOut"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "job_id": {
      "format": "uuid",
      "title": "Job Id",
      "type": "string"
    },
    "method": {
      "$ref": "#/$defs/Method"
    },
    "result": {
      "discriminator": {
        "mapping": {
          "array": "#/$defs/ArrayResult",
          "counts": "#/$defs/CountsResult"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ArrayResult"
        },
        {
          "$ref": "#/$defs/CountsResult"
        }
      ],
      "title": "Result"
    }
  },
  "required": [
    "job_id",
    "method",
    "bit_order",
    "result"
  ],
  "title": "JobResultOut",
  "type": "object"
}
