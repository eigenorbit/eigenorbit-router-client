      "title": "ErrorCode",
      "type": "string"
    },
    "Method": {
      "description": "Mirrors kit CompiledCircuit methods.",
      "enum": [
        "run",
        "sample",
        "probabilities",
        "zero_state_probability"
      ],
      "title": "Method",
      "type": "string"
    }
  },
  "description": "POST /v1/jobs/estimate response. Creates no job and no hold.\n\nvendor_cost_usd_micro + fee_usd_micro == estimate_usd_micro.",
  "properties": {
    "available_usd_micro": {
      "title": "Available Usd Micro",
      "type": "integer"
    },
    "device": {
      "title": "Device",
      "type": "string"
    },
    "estimate_usd_micro": {
      "title": "Estimate Usd Micro",
      "type": "integer"
    },
    "fee_usd_micro": {
      "minimum": 0,
      "title": "Fee Usd Micro",
      "type": "integer"
    },
    "method": {
      "$ref": "#/$defs/Method"
    },
    "price_version": {
      "title": "Price Version",
      "type": "string"
    },
    "shots": {
      "title": "Shots",
      "type": "integer"
    },
    "vendor_cost_usd_micro": {
      "minimum": 0,
      "title": "Vendor Cost Usd Micro",
      "type": "integer"
    },
    "would_reject_reason": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorCode"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "device",
    "method",
    "shots",
    "estimate_usd_micro",
    "vendor_cost_usd_micro",
    "fee_usd_micro",
    "price_version",
    "available_usd_micro",
    "would_reject_reason"
  ],
  "title": "EstimateOut",
  "type": "object"
}
