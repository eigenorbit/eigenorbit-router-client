{
  "$defs": {
    "DeviceMethodOut": {
      "description": "A method the device runs, and the shots it accepts for it (inclusive).",
      "properties": {
        "max_shots": {
          "minimum": 0,
          "title": "Max Shots",
          "type": "integer"
        },
        "method": {
          "$ref": "#/$defs/Method"
        },
        "min_shots": {
          "minimum": 0,
          "title": "Min Shots",
          "type": "integer"
        }
      },
      "required": [
        "method",
        "min_shots",
        "max_shots"
      ],
      "title": "DeviceMethodOut",
      "type": "object"
    },
    "DeviceOut": {
      "description": "A device you can run jobs on. `qubits` is the most qubits a circuit may use on it.\nFor a photonic device it is the number of optical modes. `status` is the vendor's\nstatus from the router's last check, at `status_updated_at` (null until the first\ncheck). A job is accepted only on an `online` device with a recent check.\n`available_now` says whether now is inside one of `availability_windows`, and is null\nwhen no windows are known. It does not gate a job: outside its windows a device still\naccepts jobs, and they wait in the vendor's queue. `methods` lists what the device\nruns, with the shots each method accepts.",
      "properties": {
        "availability_windows": {
          "items": {
            "$ref": "#/$defs/DeviceWindowOut"
          },
          "title": "Availability Windows",
          "type": "array"
        },
        "available_now": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Available Now"
        },
        "example_price": {
          "$ref": "#/$defs/ExamplePriceOut"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "qpu",
            "simulator"
          ],
          "title": "Kind",
          "type": "string"
        },
        "methods": {
          "items": {
            "$ref": "#/$defs/DeviceMethodOut"
          },
          "title": "Methods",
          "type": "array"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "price": {
          "$ref": "#/$defs/DevicePriceOut"
        },
        "qubits": {
          "minimum": 1,
          "title": "Qubits",
          "type": "integer"
        },
        "status": {
          "enum": [
            "online",
            "offline",
            "retired"
          ],
          "title": "Status",
          "type": "string"
        },
        "status_updated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Status Updated At"
        },
        "vendor": {
          "title": "Vendor",
          "type": "string"
        }
      },
      "required": [
        "id",
        "vendor",
        "name",
        "kind",
        "qubits",
        "status",
        "status_updated_at",
        "available_now",
        "availability_windows",
        "methods",
        "price",
        "example_price"
      ],
      "title": "DeviceOut",
      "type": "object"
    },
    "DevicePriceOut": {
      "description": "The device's current price. A job keeps the price version it was admitted with.\nAmounts are integers in micro-USD: 1000000 is $1.\n\n`duration_per_minute` (the simulators) bills device time at `per_minute_usd_micro`,\nat least `min_billable_ms`. `task_plus_shot` (the QPUs) bills `task_fee_usd_micro`\nper job plus `per_shot_usd_micro` per shot. The fields of the other model are null.\n`markup_bps` is the EigenOrbit fee on top of the vendor's price, in basis points\n(2000 is 20%).\n\n`hold_seconds` is a simulator's hold window: an estimate holds the larger of\n`min_billable_ms` and `hold_seconds` of device time, and the unused part is returned\nwhen the job is settled. It is null for `task_plus_shot`, whose estimate depends on\nthe shots instead.",
      "properties": {
        "hold_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hold Seconds"
        },
        "markup_bps": {
          "minimum": 0,
          "title": "Markup Bps",
          "type": "integer"
        },
        "min_billable_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Min Billable Ms"
        },
        "per_minute_usd_micro": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Per Minute Usd Micro"
        },
        "per_shot_usd_micro": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Per Shot Usd Micro"
        },
        "price_version": {
          "title": "Price Version",
          "type": "string"
        },
        "pricing_model": {
          "enum": [
            "duration_per_minute",
            "task_plus_shot"
          ],
          "title": "Pricing Model",
          "type": "string"
        },
        "task_fee_usd_micro": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Task Fee Usd Micro"
        }
      },
      "required": [
        "price_version",
        "pricing_model",
        "markup_bps",
        "task_fee_usd_micro",
        "per_shot_usd_micro",
        "per_minute_usd_micro",
        "min_billable_ms"
      ],
      "title": "DevicePriceOut",
      "type": "object"
    },
    "DeviceWindowOut": {
      "description": "One availability window: `day`, and inclusive start and end times, \"HH:MM:SS\" UTC.\n\nA window whose end is earlier than its start wraps past midnight into the next day.",
      "properties": {
        "day": {
          "enum": [
            "Monday",
            "Tuesday",
            "Wednesday",
            "Thursday",
            "Friday",
            "Saturday",
            "Sunday",
            "Weekdays",
            "Weekend",
            "Everyday"
          ],
          "title": "Day",
          "type": "string"
        },
        "end_utc": {
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$",
          "title": "End Utc",
          "type": "string"
        },
        "start_utc": {
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$",
          "title": "Start Utc",
          "type": "string"
        }
      },
      "required": [
        "day",
        "start_utc",
        "end_utc"
      ],
      "title": "DeviceWindowOut",
      "type": "object"
    },
    "ExamplePriceOut": {
      "description": "What one job would cost on the current price. `total_usd_micro` is the cost with\nthe EigenOrbit fee, rounded up once to a whole micro-USD, and `vendor_cost_usd_micro`\nplus `fee_usd_micro` equals it.\n\n`shots` is 1000, clamped into the device's shot range. `billed_duration_ms` is the\ndevice time priced for a `duration_per_minute` device, its minimum billable duration,\nand null for a `task_plus_shot` device. A simulator job's estimate holds the price's\nhold window instead, so it can be larger than this example.",
      "properties": {
        "billed_duration_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Billed Duration Ms"
        },
        "fee_usd_micro": {
          "minimum": 0,
          "title": "Fee Usd Micro",
          "type": "integer"
        },
        "shots": {
          "minimum": 0,
          "title": "Shots",
          "type": "integer"
        },
        "total_usd_micro": {
          "minimum": 0,
          "title": "Total Usd Micro",
          "type": "integer"
        },
        "vendor_cost_usd_micro": {
          "minimum": 0,
          "title": "Vendor Cost Usd Micro",
          "type": "integer"
        }
      },
      "required": [
        "shots",
        "billed_duration_ms",
        "vendor_cost_usd_micro",
        "fee_usd_micro",
        "total_usd_micro"
      ],
      "title": "ExamplePriceOut",
      "type": "object"
    },
    "Method": {
      "description": "What the job computes. `run`: one expectation value per observable. `sample`:\nmeasurement counts. `probabilities`: the probability of every basis state.\n`zero_state_probability`: the probability of the all-zeros state.\n`photonic_sample`: the photon counts of a linear-optical circuit, sampled on a\nphotonic device.",
      "enum": [
        "run",
        "sample",
        "probabilities",
        "zero_state_probability",
        "photonic_sample"
      ],
      "title": "Method",
      "type": "string"
    }
  },
  "description": "The devices you can run jobs on, sorted by `id`.",
  "properties": {
    "devices": {
      "items": {
        "$ref": "#/$defs/DeviceOut"
      },
      "title": "Devices",
      "type": "array"
    }
  },
  "required": [
    "devices"
  ],
  "title": "DeviceListOut",
  "type": "object"
}
